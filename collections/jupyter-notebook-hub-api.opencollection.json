{
  "opencollection": "1.0.0",
  "info": {
    "name": "Jupyter Notebook Jupyter Kernel Gateway Authorization Hub API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Hub",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Jupyter Notebook Shut down the hub",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:8888/api/shutdown",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Shut down the JupyterHub process. Optionally stop all single-user servers and the proxy."
        }
      ]
    }
  ],
  "bundled": true
}